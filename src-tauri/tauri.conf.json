{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obsidian Launcher",
  "version": "0.1.0",
  "identifier": "com.obsidian.launcher",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter frontend run dev",
    "beforeBuildCommand": "pnpm --filter frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Obsidian Launcher",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
